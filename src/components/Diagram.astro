---
interface Props {
	file: string;
	alt: string;
}

const { file, alt } = Astro.props;

const diagrams = import.meta.glob<string>('../assets/illustrations/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

const svg = Object.entries(diagrams).find(([path]) => path.endsWith(`/${file}`))?.[1];
if (!svg) {
	throw new Error(`Unknown diagram: ${file}`);
}

const altAttr = alt.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const html = svg.replace(/<svg\b/, `<svg role="img" aria-label="${altAttr}" class="diagram-svg"`);
---

<div class="diagram" set:html={html} />
